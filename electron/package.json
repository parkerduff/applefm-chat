{
  "name": "chatfm",
  "version": "0.1.0",
  "description": "ChatFM - Desktop chat app for Apple's on-device LLM",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "package": "electron-builder --mac --config",
    "dist": "electron-vite build && electron-builder --mac --config",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-slot": "^1.2.4",
    "apple-local-llm": "^1.0.0",
    "better-sqlite3": "^12.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-rebuild": "^3.2.9",
    "electron-vite": "^3.0.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "build": {
    "appId": "chat.applefm",
    "productName": "ChatFM",
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "icon": "resources/icon.icns",
      "artifactName": "ChatFM-${arch}.${ext}"
    },
    "asarUnpack": [
      "node_modules/apple-local-llm/**",
      "node_modules/better-sqlite3/**"
    ]
  }
}
